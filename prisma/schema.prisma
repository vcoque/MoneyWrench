generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Household {
  id       String @id @default(cuid())
  name     String
  currency String

  users   User[]
  invites Invite[]

  accounts      Account[]
  categories    Category[]
  savingsGoals  SavingsGoal[]
  budgetPeriods BudgetPeriod[]
  transactions  Transaction[]
  categoryRules CategoryRule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id           String    @id @default(cuid())
  householdId  String
  household    Household @relation(fields: [householdId], references: [id])
  email        String    @unique
  name         String
  // Placeholder for Task 3 (Auth.js). Nullable, unused by this task — no
  // hashing or validation logic here, just the column so Task 3 doesn't
  // need its own schema migration to add it.
  passwordHash String?

  createdInvites Invite[] @relation("InviteCreatedBy")

  createdTransactions   Transaction[]
  uploadedImportBatches ImportBatch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([householdId])
}

// Single-use, token-based household invite (Task 4). The inviter generates
// a link and shares it manually — no email-sending provider is involved.
// `token` is the unique, unguessable secret embedded in the invite URL;
// `consumedAt` being non-null is what prevents reuse, set atomically at
// redemption time (see lib/invites.ts `consumeInvite`) to close the race
// between two people redeeming the same link concurrently.
model Invite {
  id          String    @id @default(cuid())
  token       String    @unique
  householdId String
  household   Household @relation(fields: [householdId], references: [id])

  createdByUserId String
  createdBy       User   @relation("InviteCreatedBy", fields: [createdByUserId], references: [id])

  expiresAt  DateTime
  consumedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([householdId])
}

// --- Task 5: domain schema (budgeting, accounts, transactions, imports) ---

enum AccountType {
  checking
  credit_card
  savings
  cash
}

enum CategoryKind {
  expense
  savings_goal
}

enum BudgetTargetType {
  spend_limit
  save_target
}

enum TransactionType {
  expense
  income
}

enum TransactionSource {
  manual
  import
}

enum CategoryRuleMatchType {
  contains
  exact
  regex
}

model Account {
  id          String      @id @default(cuid())
  householdId String
  household   Household   @relation(fields: [householdId], references: [id])
  name        String
  type        AccountType
  // Task 6 addition (not in the original design spec's Data Model list, but
  // required by the spec's Error Handling section: records with history are
  // archived, never hard-deleted). Archiving sets this true instead of
  // deleting the row, so Transaction/ImportBatch history stays intact.
  isArchived  Boolean     @default(false)

  transactions  Transaction[]
  importBatches ImportBatch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([householdId])
}

// A Category is either an `expense` category (user-created, Task 7) or a
// `savings_goal` category (auto-created alongside a SavingsGoal, Task 9).
// `savingsGoalId` is only ever set for the latter — it is the back-link from
// the category to the goal it accumulates progress for. Contributing to a
// goal is just a Transaction posted to its linked category; there is no
// separate contribution entity (see SavingsGoal below).
model Category {
  id            String       @id @default(cuid())
  householdId   String
  household     Household    @relation(fields: [householdId], references: [id])
  name          String
  kind          CategoryKind
  savingsGoalId String?      @unique
  savingsGoal   SavingsGoal? @relation(fields: [savingsGoalId], references: [id])
  // Task 7 addition (same gap as Account hit in Task 6): the design spec's
  // Error Handling section requires archiving-not-deleting for records with
  // history (e.g. a category with existing transactions), but Task 5's
  // schema omitted archive flags entirely. Archiving sets this true instead
  // of deleting the row, so Transaction/BudgetAllocation/CategoryRule history
  // referencing it stays intact.
  isArchived    Boolean      @default(false)

  allocations   BudgetAllocation[]
  transactions  Transaction[]
  categoryRules CategoryRule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([householdId])
}

// Progress toward `targetAmount` is intentionally NOT stored here — it is
// computed on read as the sum of all-time Transactions posted to this goal's
// linked Category (via Category.savingsGoalId), so it never drifts out of
// sync with the transaction ledger.
model SavingsGoal {
  id           String    @id @default(cuid())
  householdId  String
  household    Household @relation(fields: [householdId], references: [id])
  name         String
  targetAmount Decimal

  category Category?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([householdId])
}

model BudgetPeriod {
  id                String            @id @default(cuid())
  householdId       String
  household         Household         @relation(fields: [householdId], references: [id])
  year              Int
  month             Int
  overallTarget     Decimal?
  overallTargetType BudgetTargetType?

  allocations BudgetAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([householdId, year, month])
  @@index([householdId])
}

// Task 10 addition: without a uniqueness constraint on
// (budgetPeriodId, categoryId), "set an allocation for a category in a
// period" would have to choose between blindly INSERTing (creating a
// duplicate row every time the user re-saves the same category) or doing a
// find-then-write (a TOCTOU race under concurrent household members). The
// constraint lets lib/budgets.ts's setAllocation do a single atomic
// `upsert` keyed on it instead, which prevents duplicates by construction.
model BudgetAllocation {
  id             String       @id @default(cuid())
  budgetPeriodId String
  budgetPeriod   BudgetPeriod @relation(fields: [budgetPeriodId], references: [id])
  categoryId     String
  category       Category     @relation(fields: [categoryId], references: [id])
  plannedAmount  Decimal

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([budgetPeriodId, categoryId])
  @@index([budgetPeriodId])
  @@index([categoryId])
}

model Transaction {
  id              String            @id @default(cuid())
  householdId     String
  household       Household         @relation(fields: [householdId], references: [id])
  accountId       String
  account         Account           @relation(fields: [accountId], references: [id])
  categoryId      String?
  category        Category?         @relation(fields: [categoryId], references: [id])
  date            DateTime
  amount          Decimal
  type            TransactionType
  description     String
  source          TransactionSource
  importBatchId   String?
  importBatch     ImportBatch?      @relation(fields: [importBatchId], references: [id])
  createdByUserId String
  createdByUser   User              @relation(fields: [createdByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([householdId])
  @@index([accountId])
  @@index([categoryId])
  @@index([importBatchId])
}

model ImportBatch {
  id               String   @id @default(cuid())
  accountId        String
  account          Account  @relation(fields: [accountId], references: [id])
  importedAt       DateTime @default(now())
  filename         String
  uploadedByUserId String
  uploadedByUser   User     @relation(fields: [uploadedByUserId], references: [id])

  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId])
}

model CategoryRule {
  id          String                @id @default(cuid())
  householdId String
  household   Household             @relation(fields: [householdId], references: [id])
  matchType   CategoryRuleMatchType
  pattern     String
  categoryId  String
  category    Category              @relation(fields: [categoryId], references: [id])
  priority    Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([householdId])
  @@index([categoryId])
}
