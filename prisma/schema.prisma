generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Household {
  id       String @id @default(cuid())
  name     String
  currency String

  users User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id])
  email       String    @unique
  name        String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([householdId])
}
