# Postgres connection string used by Prisma (prisma/schema.prisma reads this
# via env("DATABASE_URL")).
#
# Local dev: point this at a local Postgres instance, e.g. one started with
#   docker run --name moneywrench-pg \
#     -e POSTGRES_PASSWORD=moneywrench \
#     -e POSTGRES_DB=moneywrench \
#     -p 5432:5432 \
#     -v moneywrench-pg-data:/var/lib/postgresql/data \
#     -d postgres:16-alpine
# which matches the placeholder value below.
#
# Production: set this to the Neon connection string instead. No code
# changes are needed — only this environment variable.
DATABASE_URL="postgresql://postgres:moneywrench@localhost:5432/moneywrench"

# Auth.js (next-auth v5) session/JWT encryption secret. Required in all
# environments. Generate a real value with:
#   openssl rand -base64 33
# or `npx auth secret`. Never reuse the placeholder below outside local dev.
AUTH_SECRET="replace-with-output-of-openssl-rand-base64-33"
